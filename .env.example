# ---- Server ----
PORT=3000
NODE_ENV=development
# Generate with: openssl rand -hex 32
JWT_SECRET=change-me-to-a-long-random-string

# ---- Database ----
DATABASE_URL=postgres://suitor:suitor@localhost:5432/suitor

# ---- Token economy ----
TOKEN_COST_PER_MESSAGE=10
WELCOME_TOKENS=25

# ---- PayPal ----
# sandbox | live   (leave sandbox until you are ready for real money)
PAYPAL_MODE=sandbox
# From developer.paypal.com → Apps & Credentials (log in with the business account)
PAYPAL_CLIENT_ID=
PAYPAL_SECRET=

# ---- AI Concierge (optional) ----
# Free-tier key from Google AI Studio (aistudio.google.com → Get API key).
# Server-side only — never put this in frontend code or chat.
# Without a key, the concierge falls back to its built-in draft bank.
CONCIERGE_API_KEY=
CONCIERGE_MODEL=gemini-2.5-flash

# ---- Taste Match / Qloo (optional) ----
# Key from the Qloo hackathon (Devpost registration → API access).
# Server-side only — never put this in frontend code or chat.
# Without a key, Taste Match falls back to its built-in taste bank.
QLOO_API_KEY=
QLOO_API_BASE=https://hackathon.api.qloo.com
